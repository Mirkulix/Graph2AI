# QO Server — Provider API keys + runtime config.
#
# Copy this file to `.env` (gitignored) and fill in the values for
# the providers you actually use. Keys not needed can stay empty
# or be removed.
#
# Precedence: shell env > .env file > ~/.openclaw/.env > defaults.

# ──────────────────────────────────────────────────────────────────
# Local-first: Ollama (tier 1)
# ──────────────────────────────────────────────────────────────────
# Leave untouched if you run `ollama serve` on localhost:11434.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ──────────────────────────────────────────────────────────────────
# Fast free-tier: Groq (tier 2)
# Sign up at https://console.groq.com/keys
# ──────────────────────────────────────────────────────────────────
# GROQ_API_KEY=gsk_...

# ──────────────────────────────────────────────────────────────────
# Cloud / custom OpenAI-compatible provider (tier 3)
#
# Examples:
#   DeepSeek:   CLOUD_BASE_URL=https://api.deepseek.com/v1
#               CLOUD_MODEL=deepseek-chat
#               DEEPSEEK_API_KEY=sk-...
#   Anthropic:  CLOUD_BASE_URL=https://api.anthropic.com/v1
#               CLOUD_MODEL=claude-sonnet-4-6
#               ANTHROPIC_API_KEY=sk-ant-...
#   OpenAI:     CLOUD_BASE_URL=https://api.openai.com/v1
#               CLOUD_MODEL=gpt-4o-mini
#               ANTHROPIC_API_KEY=sk-...   (the router reads either key)
# ──────────────────────────────────────────────────────────────────
# CLOUD_BASE_URL=
# CLOUD_MODEL=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# ──────────────────────────────────────────────────────────────────
# Web search — used by the Researcher agent before every LLM call
#
# With a Tavily key the researcher gets real indexed web snippets
# (recommended). Without a key the server falls back to DuckDuckGo
# Instant Answer, which only returns hits for Wikipedia-like topics.
#
# Free Tavily tier: 1000 searches/month
# Sign up at https://tavily.com
# ──────────────────────────────────────────────────────────────────
# TAVILY_API_KEY=tvly-...

# ──────────────────────────────────────────────────────────────────
# SearXNG — self-hosted OSS meta-search (aggregates Google / Bing /
# DDG / Brave / ~70 more). MIT licensed, no tracking, no keys.
#
# Quickstart (Docker):
#   docker run --rm -d -p 8080:8080 --name searxng \
#     -v "$(pwd)/searxng:/etc/searxng" \
#     docker.io/searxng/searxng:latest
# Then edit `searxng/settings.yml` → under `search:` add `formats: [html, json]`
# Restart the container. QLANG will query the JSON endpoint directly.
# ──────────────────────────────────────────────────────────────────
# SEARXNG_URL=http://localhost:8080

# ──────────────────────────────────────────────────────────────────
# Firecrawl — URL → clean markdown (for the Researcher to READ pages
# found via search). MIT on GitHub: github.com/mendableai/firecrawl
# Options:
#   • Cloud:       set FIRECRAWL_API_KEY (500 free crawls on sign-up)
#   • Self-hosted: set FIRECRAWL_URL=http://localhost:3002
# Without either, QLANG falls back to Jina Reader (r.jina.ai/ — free,
# no key, works on most pages).
# ──────────────────────────────────────────────────────────────────
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_URL=http://localhost:3002

# Wikipedia language — default "de", falls back to "en" if no hits
# WIKI_LANG=de

# ──────────────────────────────────────────────────────────────────
# QO server runtime
# ──────────────────────────────────────────────────────────────────
# QO_PORT=4646
# QO_DATA_DIR=data
# QO_AUTH_TOKEN=                         # bearer token for /api/*
# RUST_LOG=info,qo_server=info

# ──────────────────────────────────────────────────────────────────
# Peer discovery for docker-compose.swarm.yml / multi-node dev
# ──────────────────────────────────────────────────────────────────
# QO_NODE_ID=node-a
# QO_NODE_ADDR=qo-a:4646
# PEER_DISCOVERY_SEEDS=qo-a:4646,qo-b:4646,qo-c:4646
# PEER_DISCOVERY_INTERVAL_SECS=10
