{
  "name": "qlang",
  "displayName": "QLANG",
  "description": "QLANG language support - Graph-based AI-to-AI Programming with LSP",
  "version": "0.2.0",
  "publisher": "mirkulix",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "qlang",
        "aliases": [
          "QLANG"
        ],
        "extensions": [
          ".qlang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qlang",
        "scopeName": "source.qlang",
        "path": "./syntaxes/qlang.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "qlang.run",
        "title": "QLANG: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "qlang.repl",
        "title": "QLANG: Open REPL"
      },
      {
        "command": "qlang.dashboard",
        "title": "QLANG: Open QO Dashboard"
      },
      {
        "command": "qlang.qlms.check",
        "title": "QLMS: Check Connection",
        "icon": "$(shield)"
      },
      {
        "command": "qlang.qlms.startServer",
        "title": "QLMS: Start Local QO Backend",
        "icon": "$(server)"
      },
      {
        "command": "qlang.qlms.handover",
        "title": "QLMS: Handover Graph to Agent",
        "icon": "$(export)"
      },
      {
        "command": "qlang.dashboard",
        "title": "QLANG: Open QO Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "qlang.qlms.showInbox",
        "title": "QLMS: Show Inbox (replies addressed to this IDE)",
        "icon": "$(inbox)"
      }
    ],
    "keybindings": [
      {
        "command": "qlang.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == qlang"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "qlang.run",
          "when": "editorLangId == qlang",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "QLANG",
      "properties": {
        "qlang.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable QLANG Language Server for diagnostics, completions, and hover info"
        },
        "qlang.lsp.path": {
          "type": "string",
          "default": "qlang-cli",
          "description": "Path to the qlang-cli binary (must support 'lsp' subcommand)"
        },
        "qlang.qlms.baseUrl": {
          "type": "string",
          "default": "http://localhost:4646",
          "description": "QO server base URL used by the QLMS status-bar badge. Routes /qlms/v1.1/deliver and /qlms/v1.1/reply are probed over HTTP."
        },
        "qlang.qlms.authToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token for the QO server. Falls back to the QO_AUTH_TOKEN environment variable when empty."
        },
        "qlang.qlms.seedHex": {
          "type": "string",
          "default": "",
          "description": "64-char hex seed used to sign outbound QLMS handover frames. If empty, a workspace-local seed is generated on first use and stored in workspaceState. Falls back to the QO_SEED_HEX environment variable when empty."
        },
        "qlang.qlms.inbox.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Subscribe to /api/messages/stream and surface incoming QLMS messages addressed to this IDE as VS Code notifications with an 'Open in editor' action."
        },
        "qlang.qlms.inbox.identity": {
          "type": "string",
          "default": "vscode-assistant",
          "description": "The agent name this IDE listens for on the message bus. Replies addressed to this name pop up as inbox notifications."
        }
      }
    }
  },
  "dependencies": {
    "@types/vscode": "^1.110.0",
    "typescript": "^6.0.2",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
