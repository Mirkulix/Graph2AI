[Unit]
Description=QO — QLANG + Orbit AI Companion
After=network.target

[Service]
Type=simple
User=mirkulix
WorkingDirectory=${REPO_ROOT:-.}
Environment=LLVM_SYS_180_PREFIX=/opt/llvm18
Environment=QO_PORT=4747
Environment=RUST_LOG=info
EnvironmentFile=-${HOME}/.env
ExecStart=${REPO_ROOT:-.}/target/release/qo
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
